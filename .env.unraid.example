# Set the Warcraft Logs V2 API client credentials on the Unraid server.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Web UI port on the Unraid host.
HELLOTHERELOGS_PORT=8080
HELLOTHERELOGS_DATA_PATH=/mnt/user/appdata/hellotherelogs/data

# Optional: pin both images to the same Git commit instead of following latest.
# HELLOTHERELOGS_BACKEND_IMAGE=ghcr.io/steffenlongva/hellotherelogs-backend:sha-0123456789abcdef0123456789abcdef01234567
# HELLOTHERELOGS_FRONTEND_IMAGE=ghcr.io/steffenlongva/hellotherelogs-frontend:sha-0123456789abcdef0123456789abcdef01234567

CACHE_TTL_SECONDS=900
WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WCL_GRAPHQL_URL=https://fresh.warcraftlogs.com/api/v2/client
FRONTEND_ORIGIN=http://localhost:8080
